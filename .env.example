# Optional canonical origin. Set it for production metadata/absolute links.
SITE_URL=http://localhost:3000

BETTER_AUTH_URL=http://localhost:2000
MONGODB_URI=
MONGODB_DB_NAME=the_cut
BETTER_AUTH_SECRET=

# BETTER_AUTH_SECRET must be a unique random value of at least 32 characters.
# Never put secrets in NEXT_PUBLIC_* variables.

# Resend SMTP (put actual credentials only in .env/deployment secrets; keep server-side)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Verified sender identity and security-alert recipient
MAIL_FROM=
MAIL_TO=

# ImgBB upload API key (server-only; never prefix with NEXT_PUBLIC_)
IMGBB_API_KEY=

# Optional Cloudflare Turnstile CAPTCHA hook; public site key is safe for the client
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Set to true to require verified email before sign-in (sends verification mail). Default false.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
