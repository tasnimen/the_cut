# =====================================================================
# THE CUT: environment variables  (this file is committed: placeholders only)
# =====================================================================
#
# LOCAL SETUP
#   1. If you do not have a file called .env yet, copy this file to .env
#      (PowerShell:  Copy-Item .env.example .env).
#   2. Fill the values in the ".env" file, never in this example file.
#   3. Restart "npm run dev" after EVERY change to .env (it is only read at start-up).
#   4. NEVER commit .env, never paste its values into chat, tickets or screenshots.
#   5. Variable names starting with NEXT_PUBLIC_ are visible in the browser. Never put a
#      secret in one.
#
# =====================================================================
# FILL THESE FIRST (development), in this order
# =====================================================================
#   1. MONGODB_URI                      REQUIRED  - database connection string (Database section)
#   2. MONGODB_DB_NAME                  REQUIRED  - the_cut (or a name ending in _dev / _test)
#   3. BETTER_AUTH_SECRET               REQUIRED  - random 32+ character secret (Auth section)
#   4. SITE_URL and BETTER_AUTH_URL     REQUIRED  - both http://localhost:3000 while developing
#   5. SEED_SUPER_ADMIN_EMAIL           REQUIRED  - only to create the first Super Admin (Seed section)
#      SEED_SUPER_ADMIN_PASSWORD        REQUIRED  - same
#   6. SEED_ADMIN_EMAIL / _PASSWORD     OPTIONAL  - a test Admin; leave both empty to skip
#   7. SMTP_*, MAIL_FROM, MAIL_TO       OPTIONAL for now - needed for contact and booking emails
#   8. CLOUDINARY_CLOUD_NAME / _API_KEY / _API_SECRET   REQUIRED for image uploads (Images section)
#   9. TURNSTILE_* and the rest         OPTIONAL - can stay empty
#
# =====================================================================
# 1. APP
# =====================================================================

# SITE_URL - REQUIRED in development (used for links and for trusted-origin checks)
# What: the public address of this site.
# Value: http://localhost:3000 locally; your real https:// domain in production.
# Format: http://localhost:3000
SITE_URL=http://localhost:3000

# =====================================================================
# 2. DATABASE
# =====================================================================

# MONGODB_URI - REQUIRED
# What: connection string for MongoDB Atlas (cluster "Connect" button > Drivers).
# Where: https://cloud.mongodb.com > your cluster > Connect > Drivers > copy the string.
# Format: mongodb+srv://<db-user>:<db-password>@<cluster-host>/<database>?retryWrites=true&w=majority
# Rules: URL-encode special characters in the password; Atlas "Network Access" must allow your IP.
MONGODB_URI=

# MONGODB_DB_NAME - REQUIRED
# What: database used by the app and by the seed scripts.
# Rules: the seed scripts only run against "the_cut" or a name ending in _dev or _test.
MONGODB_DB_NAME=the_cut

# =====================================================================
# 3. AUTH (Better Auth)
# =====================================================================

# BETTER_AUTH_URL - REQUIRED
# What: the origin Better Auth trusts for sign-in requests. Must equal the address you open in
#       the browser, otherwise sign-in fails with "Invalid origin".
# Format: http://localhost:3000   (the old example said 2000: that was wrong)
BETTER_AUTH_URL=http://localhost:3000

# BETTER_AUTH_SECRET - REQUIRED
# What: secret that signs sessions and tokens.
# Rules: at least 32 random characters, unique to this project, never reused from another site.
# Generate (PowerShell):  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Format: 64 hex characters, e.g. 0123abcd...(fake placeholder, generate your own)
BETTER_AUTH_SECRET=

# AUTH_REQUIRE_EMAIL_VERIFICATION - OPTIONAL (default false)
# What: true = new accounts must confirm their email before signing in (sends a mail).
# Rules: needs working SMTP settings below when true.
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# =====================================================================
# 4. SEED ACCOUNTS (used only by: npm run seed:admins:dev)
# =====================================================================
# Creates the first SUPER_ADMIN and an optional test ADMIN. Passwords are never printed or logged.
# Rules for each password: 10 to 128 characters, unique (different for each account), never reused
# from another site, must not contain the email name. Remove the two PASSWORD lines from .env
# after the accounts exist, if you like: they are only read by the seed.
# The opt-in "ALLOW_ADMIN_SEED" is NOT stored here: you set it in the terminal for one run.

# SEED_SUPER_ADMIN_EMAIL / SEED_SUPER_ADMIN_PASSWORD - REQUIRED for the seed
# Format: you@your-domain.example   /   a long unique passphrase (fake: correct-horse-battery-staple-91)
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
# OPTIONAL display name (default "Super Admin")
SEED_SUPER_ADMIN_NAME=

# SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD - OPTIONAL test Admin (leave BOTH empty to skip)
# Must be a different email and a different password than the Super Admin.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# OPTIONAL display name (default "Test Admin")
SEED_ADMIN_NAME=

# =====================================================================
# 5. EMAIL (SMTP via Nodemailer)  - OPTIONAL until you want real emails
# =====================================================================
# Used for the contact form, booking confirmations and reminders, password reset and alerts.
# Resend: https://resend.com > API Keys. Gmail: enable 2-Step Verification, then create an
# "App password" at https://myaccount.google.com/apppasswords (never use your normal password).

# SMTP_HOST - e.g. smtp.resend.com  (Gmail: smtp.gmail.com)
SMTP_HOST=
# SMTP_PORT - usually 587 (STARTTLS) or 465 (TLS)
SMTP_PORT=587
# SMTP_USER - Resend: the word "resend". Gmail: your full address.
SMTP_USER=
# SMTP_PASS - Resend: your API key (starts with re_). Gmail: the 16-character app password.
SMTP_PASS=
# MAIL_FROM - verified sender shown to customers.  Format: The Cut <no-reply@your-domain.example>
MAIL_FROM=
# MAIL_TO - inbox that receives contact messages and security alerts.  Format: owner@your-domain.example
MAIL_TO=

# =====================================================================
# 6. IMAGES (Cloudinary)  - needed for avatar, gallery and other image uploads
# =====================================================================
# Uploads and deletes happen on the server only, signed with the API secret. Create a free account at
# https://cloudinary.com, then open the dashboard: Settings (gear icon) > API Keys, or the "Product
# Environment Credentials" box on the Programmable Media dashboard. Check your values with:
#   npm run check:cloudinary
# Restart "npm run dev" and rebuild ("npm run build") after changing CLOUDINARY_CLOUD_NAME: it is also
# used to tell the image optimizer and the CSP which Cloudinary folder tree to trust.

# STORAGE_PROVIDER - OPTIONAL (default cloudinary)
# What: which image service is used for new uploads. "imgbb" is a retired legacy value kept only so
#       older images can still be deleted; new uploads always need "cloudinary".
STORAGE_PROVIDER=cloudinary

# CLOUDINARY_CLOUD_NAME - REQUIRED when STORAGE_PROVIDER=cloudinary
# What: the name of your Cloudinary account ("cloud name"). Not a secret.
# Where: dashboard, top left, or Settings > API Keys.
# Format: letters, digits, "-" or "_", e.g. my-shop-123 (placeholder)
CLOUDINARY_CLOUD_NAME=

# CLOUDINARY_API_KEY - REQUIRED when STORAGE_PROVIDER=cloudinary
# Where: Settings > API Keys.
# Format: about 15 digits, e.g. 123456789012345 (placeholder)
CLOUDINARY_API_KEY=

# CLOUDINARY_API_SECRET - REQUIRED when STORAGE_PROVIDER=cloudinary. SECRET: server-only, never prefix
# with NEXT_PUBLIC_, never paste it into chat or commit it.
# Where: Settings > API Keys (click the eye icon next to the key).
# Format: about 27 letters, digits, "-" and "_" (placeholder: abcDEF123-placeholder_xyz)
CLOUDINARY_API_SECRET=

# IMGBB_API_KEY - OPTIONAL, legacy only
# What: needed only to DELETE images that were uploaded to ImgBB before the switch. Leave empty otherwise.
IMGBB_API_KEY=

# =====================================================================
# 7. SECURITY (Cloudflare Turnstile CAPTCHA)  - OPTIONAL
# =====================================================================
# Both must be set together, or both left empty.
# Where: https://dash.cloudflare.com > Turnstile > add a site.

# TURNSTILE_SECRET_KEY - server-only secret
TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY - public site key (safe in the browser)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# =====================================================================
# 8. OPTIONAL / SET IN THE TERMINAL, NOT HERE
# =====================================================================
# NODE_ENV                       Set automatically by "npm run dev". The seed scripts need it to be
#                                "development"; set it for one run:  $env:NODE_ENV = 'development'
# ALLOW_ADMIN_SEED               Opt-in for the admin seed: YES_I_REVIEWED_THE_DEV_DATABASE (one run only)
# ALLOW_THE_CUT_BOOKING_SEED     Opt-in for the booking seed: YES_I_REVIEWED_THE_CUT_DATABASE (one run only)
# Do not store the two ALLOW_* opt-ins in .env: they are a deliberate per-run confirmation.
