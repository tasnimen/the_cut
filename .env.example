# Optional canonical origin. Set it for production metadata/absolute links.
SITE_URL=http://localhost:3000

BETTER_AUTH_URL=http://localhost:2000
MONGODB_URI=
MONGODB_DB_NAME=the_cut
BETTER_AUTH_SECRET=

# BETTER_AUTH_SECRET must be a unique random value of at least 32 characters.
# Never put secrets in NEXT_PUBLIC_* variables.

# Resend SMTP (put the actual credentials only in .env; keep them server-side)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
